# ---------------------------------------------------------------------------
# Repo layout: frontend/ (Vite + React) · backend/ (FastAPI + PostgreSQL)
# ---------------------------------------------------------------------------

# Secrets (docker compose reads the root .env; backend/.env for local runs)
.env
.env.*
!.env.example
!**/.env.example

# Frontend
node_modules
dist
dist-ssr
*.local
*.log
.candidates
.shots
.DS_Store
*.tsbuildinfo

# Backend (FastAPI)
backend/.venv/
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/uploads/
__pycache__/
*.py[cod]
.pytest_cache/

# Original photographs (kept locally, never published)
source-photos/
