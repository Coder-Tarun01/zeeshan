# ---------------------------------------------------------------------------
# Docker Compose configuration — copy to `.env` in this folder:
#     cp .env.example .env
# `docker compose` reads it automatically. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=zeeshan
POSTGRES_USER=zeeshan
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# --- API -------------------------------------------------------------------
ENVIRONMENT=production

# 48 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Origins allowed to call the API (the site as the browser sees it).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Uploaded dish photos ---------------------------------------------------
# Files land on the `uploads` volume and are served by the API at /media/<file>.
MAX_UPLOAD_MB=5
MEDIA_MAX_DIMENSION=1600

# First admin, created on the first boot only (then clear the password here).
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=

# --- Ports published on the host -------------------------------------------
# If 8000 is already taken (another dev server, Docker Desktop), use e.g. 8001
# and set VITE_API_URL to match — then rebuild the web image.
WEB_PORT=8080
API_PORT=8000

# --- Site → API URL (baked into the JavaScript at build time) --------------
# Use the public URL of the API when you deploy behind a domain.
VITE_API_URL=http://localhost:8000
