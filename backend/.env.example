# ---------------------------------------------------------------------------
# ZEESHAN Admin API — copy to `backend/.env` and fill in real values.
# Nothing here is read by the frontend; never commit the real file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL connection string used in production.
# DATABASE_URL=postgresql://zeeshan:CHANGE_ME@localhost:5432/zeeshan
#
# Local development without a Postgres server (data lives in backend/dev-admin.db):
DATABASE_URL=sqlite:///./dev-admin.db

# Signing key for the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Browser origins allowed to call the API (the Vite dev server and the live site).
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,https://zeeshan.example.com

# Failed sign-ins allowed per IP + username inside LOGIN_WINDOW_SECONDS.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Optional: create the first admin automatically on boot (only if no user exists).
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=
